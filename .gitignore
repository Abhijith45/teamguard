# ==============================================================================
# TeamGuard Repository - Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
!.env.example
!.env.*.example
!backend/.env.example
!frontend/.env.example

# Private keys and certificates
*.pem
*.key
*.cert
*.crt
credentials.json
*credentials*.json

# ------------------------------------------------------------------------------
# 2. Dependencies
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnpm-store/
jspm_packages/
web_modules/

# ------------------------------------------------------------------------------
# 3. Build & Distribution Artifacts
# ------------------------------------------------------------------------------
dist/
dist-ssr/
frontend/dist/
build/
out/
.vite/
frontend/.vite/
.cache/
.parcel-cache/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 5. Database & Local Data Stores
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sql.bak
dump.rdb
backend/backups/

# ------------------------------------------------------------------------------
# 6. AI Agent Workspaces, Skills, Rules & Handoffs
# ------------------------------------------------------------------------------
AGENTS.md
**/AGENTS.md
.agents/
**/.agents/
backend/.agents/
frontend/.agents/
frontend/design-system/
.gemini/
.tempmediaStorage/

# AI-generated audit reports, task scratch logs & planning archives
audit_task_*.md
*_report.md
scratch/
docs/

# ------------------------------------------------------------------------------
# 7. Screenshots, Visual Audits & Ephemeral Image Dumps
# ------------------------------------------------------------------------------
audit_screenshots/
calendar_v2_screenshots/
click-up/
phase2_screenshots/
visual_audit_screenshots/
frontend/views/
frontend/visual_audit/
frontend/visual_audit_screenshots/

# Ephemeral test screenshot capture scripts
frontend/capture_*.js
frontend/visual_audit.js

# Prevent accidental image and binary dumps while preserving app assets
*.png
*.jpg
*.jpeg
*.webp
!frontend/public/*.png
!frontend/public/*.jpg
!frontend/public/*.jpeg
!frontend/public/*.webp
!frontend/public/*.ico
!frontend/src/assets/*.png
!frontend/src/assets/*.jpg
!frontend/src/assets/*.jpeg
!frontend/src/assets/*.webp
!frontend/src/assets/*.svg

# ------------------------------------------------------------------------------
# 8. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
.playwright/

# ------------------------------------------------------------------------------
# 9. IDEs & Operating System Metadata
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
*.swp
*.swo
*.swn
*~
.#*
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
