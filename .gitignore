# ==============================================================================
# TeamGuard RBAC Repository - Git Ignore
# ==============================================================================
# The files and directories listed below must NOT be pushed to GitHub.
# They include sensitive secrets, dependencies, build artifacts, runtime logs,
# database files, editor/OS caches, and developer scratch files.

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Secrets (NEVER push credentials or keys to GitHub)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly keep example configuration templates tracked
!.env.example
!.env.*.example

# Private keys, certificates, and auth credentials
*.pem
*.key
*.cert
*.crt
credentials.json
*credentials*.json

# ------------------------------------------------------------------------------
# 2. Dependencies (Installed locally via npm / pnpm / yarn)
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
jspm_packages/
web_modules/

# ------------------------------------------------------------------------------
# 3. Build & Distribution Artifacts (Generated code from Vite / bundlers)
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.vite/
.cache/
.parcel-cache/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Logs, Diagnostics & Process Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 5. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
.playwright/

# ------------------------------------------------------------------------------
# 6. Database & Local Data Stores (Prevent leaking local databases & dumps)
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sql.bak
dump.rdb

# ------------------------------------------------------------------------------
# 7. Python Artifacts (Automation scripts in .agents)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
ENV/
*.egg-info/

# ------------------------------------------------------------------------------
# 8. Scratch Scripts & AI / Agent Workspaces
# ------------------------------------------------------------------------------
scratch/
.gemini/
.tempmediaStorage/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 9. IDEs, Code Editors & Tooling Configs
# ------------------------------------------------------------------------------
# JetBrains / WebStorm / IntelliJ
.idea/
*.iml
*.iws

# Visual Studio Code (allow team recommended settings, ignore workspace overrides)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Vim / Emacs swap and backup files
*.swp
*.swo
*.swn
*~
.#*

# ------------------------------------------------------------------------------
# 10. Operating System Metadata Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
