# ==============================================================================
# TeamGuard Backend - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` for local development. Never commit `.env` to Git.

# Database Connection (PostgreSQL 14+)
# For local Postgres: postgresql://postgres:postgres@localhost:5432/teamguard
# For Render / Neon / Supabase: postgresql://user:password@hostname:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teamguard"

# Port & Network
PORT=5000

# CORS Allowed Origins (Comma-separated for multiple origins, no trailing slashes)
# Local: http://localhost:5173
# Production on Netlify: https://your-teamguard-app.netlify.app
FRONTEND_ORIGIN="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# JWT Authentication Secrets (Must be at least 32 characters)
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters-super-secure"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Cross-Site Cookie Settings
# For local development: COOKIE_SAME_SITE=lax, COOKIE_SECURE=false
# For production cross-domain (Netlify + Render): COOKIE_SAME_SITE=none, COOKIE_SECURE=true
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"

# Initial Bootstrap Administrator (Auto-seeded when database is empty)
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_EMAIL="admin@teamguard.local"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-long-unique-secure-password"
