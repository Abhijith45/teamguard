# Copy this file to `.env` and replace all placeholders. Never commit `.env`.

# URL-encode reserved characters in the username or password (for example, @ as %40).
DATABASE_URL="postgresql://user:password@localhost:5432/rbacdb"
PORT=5000
FRONTEND_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
BOOTSTRAP_ADMIN_NAME="Application Admin"
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-long-unique-password"
