datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  isSuspended     Boolean      @default(false)
  suspendedAt     DateTime?
  suspensionReason String?
  storageQuotaBytes BigInt       @default(10737418240)
  usedStorageBytes  BigInt       @default(0)
  memberships Membership[]
  roles       Role[]
  projects    Project[]
  tasks       Task[]
  subtasks    Subtask[]
  comments        Comment[]
  files           FileAsset[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  notificationPreferences NotificationPreference[]
  platformAuditLogs PlatformAuditLog[]
  breakGlassAlerts BreakGlassAlertOutbox[]
  invitations     MembershipInvitation[]
  spaces          Space[]
  customFields    CustomField[]
  accessRequests  AccessRequest[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  username        String           @unique
  email           String           @unique
  passwordHash    String
  avatarUrl       String?
  isActive        Boolean          @default(true)
  isPlatformAdmin Boolean          @default(false)
  memberships     Membership[]
  refreshSessions RefreshSession[]
  createdTasks    Task[]           @relation("TaskCreator")
  assignedTasks   Task[]           @relation("TaskAssignee")
  comments        Comment[]
  uploadedFiles   FileAsset[]
  auditLogs       AuditLog[]
  notifications   Notification[]   @relation("UserNotifications")
  actorNotifications Notification[] @relation("ActorNotifications")
  notificationPreferences NotificationPreference[]
  platformAuditLogs PlatformAuditLog[] @relation("PlatformOperator")
  breakGlassOutboxes BreakGlassAlertOutbox[] @relation("BreakGlassOperator")
  designatedBreakGlasses BreakGlassAlertOutbox[] @relation("BreakGlassDesignee")
  invitationsSent        MembershipInvitation[]  @relation("InvitationInviter")
  invitationsAccepted    MembershipInvitation[]  @relation("InvitationAcceptedBy")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Membership {
  id             Int              @id @default(autoincrement())
  userId         Int
  organizationId Int
  department     String?
  status         String           @default("ACTIVE")
  accountType    AccountType      @default(MEMBER)
  joinedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]
  spaceMemberships SpaceMember[]
  createdSpaces    Space[]          @relation("SpaceCreator")
  accessRequests   AccessRequest[]  @relation("AccessRequester")
  reviewedRequests AccessRequest[]  @relation("AccessReviewer")

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, accountType])
}

model Role {
  id             Int              @id @default(autoincrement())
  organizationId Int?
  name           String
  slug           String
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    MembershipRole[]
  permissions    RolePermission[]
  invitations    MembershipInvitation[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          Int              @id @default(autoincrement())
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([resource, action])
}

model MembershipRole {
  membershipId Int
  roleId       Int
  assignedAt   DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Project {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  key            String?
  description    String?
  status         String       @default("ACTIVE")
  progress       Int          @default(0)
  priority       String       @default("MEDIUM")
  isArchived     Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spaceId        Int?
  space          Space?       @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  tasks          Task[]
  files          FileAsset[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([spaceId])
  @@index([organizationId, spaceId])
  @@index([deletedAt])
  @@index([organizationId, deletedAt])
  @@index([organizationId, isArchived])
}

model Task {
  id               Int          @id @default(autoincrement())
  organizationId   Int
  projectId        Int
  title            String
  description      String?
  status           String       @default("TODO")
  priority         String       @default("MEDIUM")
  assigneeId       Int?
  creatorId        Int
  dueDate          DateTime?
  completedAt      DateTime?
  order            Int          @default(0)
  commentsCount    Int          @default(0)
  attachmentsCount Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee         User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator          User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  subtasks         Subtask[]
  comments         Comment[]
  customFieldValues CustomFieldValue[]

  @@index([organizationId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, dueDate])
}

model Subtask {
  id             Int          @id @default(autoincrement())
  organizationId Int
  taskId         Int
  title          String
  isCompleted    Boolean      @default(false)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([taskId, order])
}

model Comment {
  id             Int          @id @default(autoincrement())
  organizationId Int
  taskId         Int
  authorId       Int
  content        String
  editedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([taskId, createdAt])
  @@index([authorId])
}

model FileAsset {
  id             Int          @id @default(autoincrement())
  organizationId Int
  projectId      Int?
  name           String
  sizeBytes      Int          @default(0)
  fileType       String       @default("FILE")
  storageKey     String?
  mimeType       String?
  status         String       @default("READY")
  etag           String?
  checksumSha256 String?
  confirmedAt    DateTime?
  url            String?
  uploadedById   Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy     User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@index([storageKey])
  @@index([status])
}

model AuditLog {
  id             Int          @id @default(autoincrement())
  organizationId Int
  actorId        Int?
  action         String
  resourceType   String
  resourceId     String?
  details        String?
  outcome        String       @default("SUCCESS")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model RefreshSession {
  id                  String    @id @default(cuid())
  userId              Int
  tokenHash           String    @unique
  familyId            String?
  expiresAt           DateTime
  revokedAt           DateTime?
  rotatedAt           DateTime?
  replacedBySessionId String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, expiresAt])
}

model Notification {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  actorId        Int?
  type           String
  title          String
  message        String
  resourceType   String
  resourceId     String
  link           String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?        @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, userId, isRead])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id                      Int          @id @default(autoincrement())
  userId                  Int
  organizationId          Int?
  emailDigest             String       @default("DAILY")
  notifyTaskAssigned      Boolean      @default(true)
  notifyTaskStatusChanged Boolean      @default(true)
  notifyCommentAdded      Boolean      @default(true)
  notifyProjectArchived   Boolean      @default(true)
  notifyDueSoon           Boolean      @default(true)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization            Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model PlatformAuditLog {
  id                   Int           @id @default(autoincrement())
  operatorId           Int
  targetOrganizationId Int?
  ticketId             String
  action               String
  justification        String
  prevLogHash          String
  currentHash          String
  ipAddress            String?
  metadata             Json?
  createdAt            DateTime      @default(now())
  operator             User          @relation("PlatformOperator", fields: [operatorId], references: [id], onDelete: Cascade)
  targetOrganization   Organization? @relation(fields: [targetOrganizationId], references: [id], onDelete: SetNull)

  @@index([operatorId])
  @@index([targetOrganizationId])
  @@index([createdAt])
}

model BreakGlassAlertOutbox {
  id                   Int          @id @default(autoincrement())
  targetOrganizationId Int
  designatedMemberId   Int
  operatorId           Int
  ticketId             String
  justification        String
  recipients           Json
  payload              Json
  status               String       @default("PENDING")
  attempts             Int          @default(0)
  lastError            String?
  dispatchedAt         DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  targetOrganization   Organization @relation(fields: [targetOrganizationId], references: [id], onDelete: Cascade)
  operator             User         @relation("BreakGlassOperator", fields: [operatorId], references: [id], onDelete: Cascade)
  designatedMember     User         @relation("BreakGlassDesignee", fields: [designatedMemberId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetOrganizationId])
  @@index([createdAt])
}

model PlatformMfaNonce {
  id                   Int       @id @default(autoincrement())
  nonce                String    @unique
  operatorId           Int
  targetOrganizationId Int?
  purpose              String    @default("break-glass")
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime  @default(now())

  @@index([nonce])
  @@index([expiresAt])
}

model MembershipInvitation {
  id             Int          @id @default(autoincrement())
  organizationId Int
  inviterId      Int
  roleId         Int
  email          String
  department     String?
  tokenHash      String       @unique
  status         String       @default("PENDING")
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  acceptedBy     User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ==========================================
// 1. ACCOUNT CLASSIFICATION & ACCESS TIERS
// ==========================================

enum AccountType {
  MEMBER
  LIMITED_MEMBER
  GUEST
}

enum SpaceAccessLevel {
  FULL
  EDIT
  COMMENT
  VIEW
}

enum CustomFieldType {
  TEXT
  NUMBER
  CURRENCY
  DROPDOWN
  DATE
  CHECKBOX
}

// ==========================================
// 2. SPATIAL CONTAINER HIERARCHY (ReBAC)
// ==========================================

model Space {
  id             Int           @id @default(autoincrement())
  organizationId Int
  creatorId      Int?
  name           String
  slug           String
  description    String?
  icon           String?       @default("Folder")
  color          String?       @default("#6366f1")
  isPrivate      Boolean       @default(false)
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        Membership?   @relation("SpaceCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  projects       Project[]
  members        SpaceMember[]
  customFields   CustomField[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([creatorId])
  @@index([organizationId, isPrivate])
  @@index([organizationId, isArchived])
}

model SpaceMember {
  id           Int              @id @default(autoincrement())
  spaceId      Int
  membershipId Int
  accessLevel  SpaceAccessLevel @default(VIEW)
  createdAt    DateTime         @default(now())

  space        Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  membership   Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([spaceId, membershipId])
  @@index([spaceId])
  @@index([membershipId])
}

// ==========================================
// 3. FIELD-LEVEL ABAC & CUSTOM FIELDS
// ==========================================

model CustomField {
  id             Int                @id @default(autoincrement())
  organizationId Int
  spaceId        Int?
  name           String
  fieldKey       String
  fieldType      CustomFieldType    @default(TEXT)
  options        Json?
  hideFromGuests Boolean            @default(false)
  adminOnly      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space          Space?             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  values         CustomFieldValue[]

  @@unique([organizationId, fieldKey])
  @@index([organizationId])
  @@index([spaceId])
}

model CustomFieldValue {
  id            Int         @id @default(autoincrement())
  customFieldId Int
  taskId        Int
  valueText     String?
  valueNumber   Float?
  valueJson     Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, taskId])
  @@index([taskId])
  @@index([customFieldId])
}

// ==========================================
// 4. ACCESS REQUEST WORKFLOW (Self-Service)
// ==========================================

model AccessRequest {
  id                     Int          @id @default(autoincrement())
  organizationId         Int
  requesterMembershipId  Int
  resourceType           String
  resourceId             Int
  requestedLevel         String       @default("VIEW")
  justification          String
  status                 String       @default("PENDING")
  reviewedByMembershipId Int?
  rejectionReason        String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester              Membership   @relation("AccessRequester", fields: [requesterMembershipId], references: [id], onDelete: Cascade)
  reviewer               Membership?  @relation("AccessReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([requesterMembershipId])
  @@index([reviewedByMembershipId])
  @@index([organizationId, resourceType, resourceId])
}


